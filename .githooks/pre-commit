#!/bin/sh
#
# Keep AGENTS.md — the cold-start briefing for AI tools — in step with the code.
#
# This is a GIT hook, not an editor hook: it runs on `git commit` no matter which
# editor, AI tool, or model produced the change. That is the point. An assistant
# specific reminder stops working the moment you switch tools, which is exactly
# when an accurate AGENTS.md matters most.
#
# It does two things:
#   1. Regenerates the auto-derived blocks (roles, status enums, lifecycle,
#      counts) and stages the result. Fully automatic, no judgement needed.
#   2. Warns — never blocks — when structural files are staged without any
#      accompanying AGENTS.md prose change, since the hand-written sections
#      (conventions, gotchas, the approval-chain narrative) cannot be generated.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass once:  git commit --no-verify

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "AGENTS.md sync skipped: node not found on PATH." >&2
  exit 0
fi

# --- 1. Regenerate the derived blocks -----------------------------------------
BEFORE=""
[ -f AGENTS.md ] && BEFORE=$(git hash-object AGENTS.md)

node scripts/sync-agents-md.mjs || {
  echo "AGENTS.md sync failed — commit continuing. Run: node scripts/sync-agents-md.mjs" >&2
  exit 0
}

AFTER=""
[ -f AGENTS.md ] && AFTER=$(git hash-object AGENTS.md)

if [ "$BEFORE" != "$AFTER" ]; then
  git add AGENTS.md
  echo "AGENTS.md: auto-derived sections refreshed and staged."
fi

# --- 2. Nudge on structural changes -------------------------------------------
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

STRUCTURAL=$(printf '%s\n' "$STAGED" | grep -E \
  '^(lib/auth/(roles|rbac)\.ts|types/database\.ts|lib/constants/.*\.ts|supabase/migrations/.*\.sql|hooks/.*\.ts|lib/validations/.*\.ts)$' \
  || true)

if [ -n "$STRUCTURAL" ]; then
  # Did the human/model touch the prose too, or only the generated blocks?
  PROSE=$(git diff --cached -U0 -- AGENTS.md | grep -E '^\+' | grep -v '^+++' \
          | grep -vE '^\+\s*$' | grep -vE 'AUTO:|Generated by scripts/' || true)
  if [ -z "$PROSE" ]; then
    echo ""
    echo "  ⚠  AGENTS.md — structural files changed, but no prose was updated:"
    printf '       %s\n' $STRUCTURAL
    echo ""
    echo "     The generated blocks are handled. Check whether the hand-written"
    echo "     sections (Roles, Domain model, Conventions, Gotchas) are still"
    echo "     accurate — a machine cannot infer those."
    echo "     Not blocking this commit."
    echo ""
  fi
fi

exit 0
