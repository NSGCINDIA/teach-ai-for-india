# ─────────────────────────────────────────────────────────────────────────────
# Teach AI for India — environment template
#
#   cp .env.example .env.local     then fill in the values below.
#
# The README has instructed this copy since the project started, but the file it
# names never existed. Every variable here is one the code actually reads; the
# list was taken from the source, not from memory.
#
# .env.local is gitignored. Never commit real values, and never give a secret a
# NEXT_PUBLIC_ prefix — that ships it to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase (required for anything behind auth) ────────────────────────────
# Project URL and anon key: Dashboard → Project Settings → API.
# The public marketing site renders without these — impact numbers fall back to
# last-known-good values and the middleware no-ops — but every dashboard and
# admin route needs a real project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Newer Supabase projects issue a "publishable" key in place of the anon key.
# The client prefers this when set and falls back to the anon key above, so fill
# in whichever one your project shows. Leave the other blank.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS entirely — used for invites and other privileged
# admin operations. MUST NOT be prefixed NEXT_PUBLIC_, and must never reach the
# browser; lib/supabase/admin.ts throws if constructed client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Transactional email (Resend) ────────────────────────────────────────────
# Invites, password resets and notification mail. Without these the flows that
# send mail fail, but nothing else breaks.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Teach AI for India <noreply@teachaiforindia.org>

# Where contact-form and volunteer-application notifications are delivered.
# Optional — those flows succeed even when it is unset.
ADMIN_NOTIFICATION_EMAIL=

# ─── Site ────────────────────────────────────────────────────────────────────
# Base URL used to build invite and password-reset links, and as the SEO
# metadataBase. Must match the deployed origin or those links will point at the
# wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for the cron route, compared with timingSafeEqual. Generate one
# with:  openssl rand -hex 32
CRON_SECRET=
